# ~/.hermes/profiles/workbench/.env  (setup-profile.sh appends missing keys only; never overwrites)
API_SERVER_ENABLED=true
API_SERVER_PORT=8643
API_SERVER_HOST=127.0.0.1
# API_SERVER_KEY=<generated by setup-profile.sh: openssl rand -hex 32>
# WORKBENCH_MCP_TOKEN=<paste contents of $WORKBENCH_DATA_DIR/mcp_token (NOT ./token: the UI token is rejected on /mcp)>
# LLM provider key(s): run `hermes -p workbench model` / `hermes -p workbench setup`
